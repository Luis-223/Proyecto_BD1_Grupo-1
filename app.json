{
  "expo": {
    "name": "FitManager",
    "slug": "FitManager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fitmanager-icono.png",
    "scheme": "fitmanager",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/fitmanager-icono.png"
    },
    "android": {
      "package": "com.tuusuario.fitmanager",
      "adaptiveIcon": {
        "backgroundColor": "#070E07",
        "foregroundImage": "./assets/images/fitmanager-icono-android.png"
      },
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "HIGH_SPEED_SENSOR"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/fitmanager-icono.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070E07",
          "image": "./assets/images/fitmanager-splash.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Permite a la aplicación registrar tus pasos para la actividad física."
        }
      ],
      "expo-image",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ab80bd17-c301-4c1f-bbe8-9d7dc494ce41"
      }
    }
  }
}
