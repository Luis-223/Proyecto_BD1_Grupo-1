# .env del SERVIDOR (va en /opt/fitmanager/servidor/.env y NUNCA se sube a GitHub)
PORT=3000
HOST=127.0.0.1

# Datos de Azure SQL: los entrega el compañero de base de datos
DB_SERVER=nombre-del-servidor.database.windows.net
DB_PORT=1433
DB_NAME=FitManager
DB_USER=fitmanager_servidor
DB_PASSWORD=
DB_ENCRYPT=true

# Clave NUEVA para firmar los tokens (no la de tu PC):
# se genera en el servidor con   openssl rand -hex 32
JWT_SECRET=
